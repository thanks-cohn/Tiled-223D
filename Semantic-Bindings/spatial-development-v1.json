{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tiled-223d/spatial-development-v1.schema.json",
  "title": "Tiled-223D deterministic replay bundle",
  "type": "object",
  "required": ["schemaVersion", "checkpoint", "frames"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "name": {"type": "string", "maxLength": 120},
    "metadata": {"type": "object"},
    "fixedStepSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.05},
    "checkpoint": {
      "type": "object",
      "required": ["worldScale", "position", "yaw", "forwardVelocity", "verticalVelocity", "cameraChoice"]
    },
    "frames": {
      "type": "array", "minItems": 1, "maxItems": 1800,
      "items": {
        "type": "object", "required": ["index", "dt", "controls"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "dt": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.05},
          "controls": {
            "type": "object",
            "required": ["turn", "forward", "climb", "boost", "camera", "scale"],
            "properties": {
              "turn": {"type": "number", "minimum": -1, "maximum": 1},
              "forward": {"type": "number", "minimum": -1, "maximum": 1},
              "climb": {"type": "number", "minimum": -1, "maximum": 1},
              "boost": {"type": "boolean"},
              "camera": {"enum": ["auto", "forward", "overview"]},
              "scale": {"enum": ["current", "bigger", "massive"]}
            }, "additionalProperties": false
          }
        }, "additionalProperties": false
      }
    }
  }, "additionalProperties": true
}
